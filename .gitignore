# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Credenciais e segredos — NUNCA versionar
.env
*.key
*_secret.json
*token*.json

# Banco operacional e backups (dados, nao codigo)
database/*.sqlite
database/*.sqlite-wal
database/*.sqlite-shm
database/backups/
*.db
*.db-wal

# Coleta bruta e cache (dados de terceiros, nao redistribuir)
data/*
!data/collection_report.json
!data/card_roles.yaml
cache/
evidence/
raw/
*.html

# Logs de execucao (artefatos de runtime, nao fonte)
*.log

# Sistema
.DS_Store
Thumbs.db

# Imagens de carta de terceiros (artes TPC/DeNA via CDN Limitless) - NUNCA versionar
