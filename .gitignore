tests/vision/fixtures/*.webp
tests/vision/fixtures/*.png
tests/vision/fixtures/*.jpg
tests/vision/fixtures_bad/*.webp
tests/vision/fixtures_bad/*.png
tests/vision/fixtures_bad/*.jpg
